Ginibre.gaussianMatrix_factorialStatistic : ∀ (k m : ℕ),
  0 < k + m →
    ∀ (f : (Fin k → ℂ) → ℝ),
      Measurable f →
        MeasureTheory.Integrable (fun z => f z * (Ginibre.kernelDet (Ginibre.kernel (k + m)) k z).re)
            MeasureTheory.volume →
          MeasureTheory.Integrable
              (fun A => Ginibre.factorialStatistic k (k + m) f (Ginibre.schurSpectrum (Matrix.of (Function.curry A))))
              (Ginibre.gaussianMatrixLaw (k + m) ↑(k + m)) ∧
            ∫ (A : Fin (k + m) × Fin (k + m) → ℂ),
                Ginibre.factorialStatistic k (k + m) f
                  (Ginibre.schurSpectrum (Matrix.of (Function.curry A))) ∂Ginibre.gaussianMatrixLaw (k + m) ↑(k + m) =
              ∫ (z : Fin k → ℂ), f z * (Ginibre.kernelDet (Ginibre.kernel (k + m)) k z).re
Ginibre.gaussianMatrix_integral_linearStatistic_all : ∀ (n : ℕ) (f : ℂ → ℝ),
  Measurable f →
    MeasureTheory.Integrable (fun z => f z * Ginibre.ginibreIntensity n z) MeasureTheory.volume →
      ∫ (A : Fin n × Fin n → ℂ),
          Ginibre.linearStatistic n f
            (Ginibre.schurSpectrum (Matrix.of (Function.curry A))) ∂Ginibre.gaussianMatrixLaw n ↑n =
        ∫ (z : ℂ), f z * Ginibre.ginibreIntensity n z
Ginibre.gaussianEigenvalueCovariance_all : ∀ (n : ℕ) (f g : ℂ → ℝ),
  Measurable f →
    Measurable g →
      MeasureTheory.Integrable (fun z => f z ^ 2 * Ginibre.ginibreIntensity n z) MeasureTheory.volume →
        MeasureTheory.Integrable (fun z => g z ^ 2 * Ginibre.ginibreIntensity n z) MeasureTheory.volume →
          Ginibre.gaussianEigenvalueCovariance n f g = Ginibre.ginibreCovarianceForm n f g
Ginibre.gaussianEigenvalueVariance_all_energy : ∀ (n : ℕ) (f : ℂ → ℝ),
  Measurable f →
    MeasureTheory.Integrable (fun z => f z ^ 2 * Ginibre.ginibreIntensity n z) MeasureTheory.volume →
      Ginibre.gaussianEigenvalueVariance n f = 1 / 2 * ∫ (p : ℂ × ℂ), (f p.1 - f p.2) ^ 2 * Ginibre.kernelWeight n p
Ginibre.gaussianEigenvalueVariance_all_le : ∀ (n : ℕ) (f : ℂ → ℝ),
  Measurable f →
    MeasureTheory.Integrable (fun z => f z ^ 2 * Ginibre.ginibreIntensity n z) MeasureTheory.volume →
      0 ≤ Ginibre.gaussianEigenvalueVariance n f ∧
        Ginibre.gaussianEigenvalueVariance n f ≤ 2 * ∫ (z : ℂ), f z ^ 2 * Ginibre.ginibreIntensity n z
def Ginibre.gaussianEigenvalueCovariance : ℕ → (ℂ → ℝ) → (ℂ → ℝ) → ℝ :=
fun n f g =>
  ∫ (A : Fin n × Fin n → ℂ),
      Ginibre.linearStatistic n f (Ginibre.schurSpectrum (Matrix.of (Function.curry A))) *
        Ginibre.linearStatistic n g
          (Ginibre.schurSpectrum (Matrix.of (Function.curry A))) ∂Ginibre.gaussianMatrixLaw n ↑n -
    (∫ (A : Fin n × Fin n → ℂ),
        Ginibre.linearStatistic n f
          (Ginibre.schurSpectrum (Matrix.of (Function.curry A))) ∂Ginibre.gaussianMatrixLaw n ↑n) *
      ∫ (A : Fin n × Fin n → ℂ),
        Ginibre.linearStatistic n g
          (Ginibre.schurSpectrum (Matrix.of (Function.curry A))) ∂Ginibre.gaussianMatrixLaw n ↑n
def Ginibre.gaussianEigenvalueVariance : ℕ → (ℂ → ℝ) → ℝ :=
fun n f => Ginibre.gaussianEigenvalueCovariance n f f
