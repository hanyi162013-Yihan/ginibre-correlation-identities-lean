@Ginibre.det_fderiv_schurEntryCoordinates_everywhere : ∀ {n : ℕ} (S : Matrix (Fin n) (Fin n) ℂ),
  S.IsUpperTriangular →
    ∀ (x : Ginibre.SchurTangent n),
      (fderiv ℝ (Ginibre.schurEntryCoordinates S) x).det =
        (∏ p,
            ‖(S + ↑x.2) (Ginibre.schurCol p) (Ginibre.schurCol p) -
                  (S + ↑x.2) (Ginibre.schurRow p) (Ginibre.schurRow p)‖ ^
              2) *
          Ginibre.schurAngularJacobian x.1
Ginibre.schurAngularJacobian_zero : ∀ (n : ℕ), Ginibre.schurAngularJacobian 0 = 1
@Ginibre.lintegral_schurEntryCoordinates_image : ∀ {n : ℕ} (S : Matrix (Fin n) (Fin n) ℂ) (hS : S.IsUpperTriangular)
  (hz : Function.Injective fun i => S i i) (s : Set (Ginibre.SchurTangent n)),
  MeasurableSet s →
    s ⊆ (Ginibre.schurLocalChart S hS hz).source →
      ∀ (g : Ginibre.SchurTangent n → ENNReal),
        ∫⁻ (y : Ginibre.SchurTangent n) in Ginibre.schurEntryCoordinates S '' s, g y ∂Ginibre.schurCoordinateVolume n =
          ∫⁻ (x : Ginibre.SchurTangent n) in s,
            ENNReal.ofReal (Ginibre.schurJacobianWeight S x) *
              g (Ginibre.schurEntryCoordinates S x) ∂Ginibre.schurCoordinateVolume n
@Ginibre.integrableOn_schurEntryCoordinates_image_iff : ∀ {n : ℕ} (S : Matrix (Fin n) (Fin n) ℂ)
  (hS : S.IsUpperTriangular) (hz : Function.Injective fun i => S i i) (s : Set (Ginibre.SchurTangent n)),
  MeasurableSet s →
    s ⊆ (Ginibre.schurLocalChart S hS hz).source →
      ∀ (g : Ginibre.SchurTangent n → ℝ),
        MeasureTheory.IntegrableOn g (Ginibre.schurEntryCoordinates S '' s) (Ginibre.schurCoordinateVolume n) ↔
          MeasureTheory.IntegrableOn (fun x => Ginibre.schurJacobianWeight S x * g (Ginibre.schurEntryCoordinates S x))
            s (Ginibre.schurCoordinateVolume n)
@Ginibre.integral_schurEntryCoordinates_image : ∀ {n : ℕ} (S : Matrix (Fin n) (Fin n) ℂ) (hS : S.IsUpperTriangular)
  (hz : Function.Injective fun i => S i i) (s : Set (Ginibre.SchurTangent n)),
  MeasurableSet s →
    s ⊆ (Ginibre.schurLocalChart S hS hz).source →
      ∀ (g : Ginibre.SchurTangent n → ℝ),
        ∫ (y : Ginibre.SchurTangent n) in Ginibre.schurEntryCoordinates S '' s, g y ∂Ginibre.schurCoordinateVolume n =
          ∫ (x : Ginibre.SchurTangent n) in s,
            Ginibre.schurJacobianWeight S x * g (Ginibre.schurEntryCoordinates S x) ∂Ginibre.schurCoordinateVolume n
def Ginibre.schurCoordinateVolume : (n : ℕ) → MeasureTheory.Measure (Ginibre.SchurTangent n) :=
fun n => MeasureTheory.Measure.map (⇑(Ginibre.schurFlatEntryEquiv n)) MeasureTheory.volume
def Ginibre.schurAngularJacobian : {n : ℕ} → (Ginibre.SchurLower n → ℂ) → ℝ :=
fun {n} w => LinearMap.det (Ginibre.schurLowerEntries ∘ₗ Ginibre.schurAngularFrame w)
def Ginibre.schurAngularFrame : {n : ℕ} →
  (Ginibre.SchurLower n → ℂ) → (Ginibre.SchurLower n → ℂ) →ₗ[ℝ] Matrix (Fin n) (Fin n) ℂ :=
fun {n} w =>
  {
    toFun := fun v =>
      NormedSpace.exp (-(Ginibre.schurAngularCLM n) w) *
        (fderiv ℝ (fun u => NormedSpace.exp ((Ginibre.schurAngularCLM n) u)) w) v,
    map_add' := ⋯, map_smul' := ⋯ }
