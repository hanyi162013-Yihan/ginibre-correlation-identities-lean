              0 < (Ginibre.realifyMatrix (Ginibre.schurLowerMatrix S)).det
@Ginibre.exists_eigenbasis_of_charpoly_separable : ∀ {E : Type u_1} [inst : AddCommGroup E] [inst_1 : Module ℂ E]
  [inst_2 : FiniteDimensional ℂ E] (n : ℕ) (f : Module.End ℂ E),
  Module.finrank ℂ E = n →
    (LinearMap.charpoly f).Separable → ∃ b z, Function.Injective z ∧ ∀ (i : Fin n), f (b i) = z i • b i
Ginibre.gaussianMatrix_exists_regular_schur_ae : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    ∀ᵐ (A : Fin n × Fin n → ℂ) ∂Ginibre.gaussianMatrixLaw n a,
      ∃ U S,
        U.conjTranspose * U = 1 ∧
          S.IsUpperTriangular ∧
            Matrix.of (Function.curry A) = U * S * U.conjTranspose ∧
              0 < (Ginibre.realifyMatrix (Ginibre.schurLowerMatrix S)).det
