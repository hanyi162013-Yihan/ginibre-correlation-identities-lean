Ginibre.gaussianMatrix_schur_chart_coverage_ae : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    ∀ᵐ (A : Fin n × Fin n → ℂ) ∂Ginibre.gaussianMatrixLaw n a,
      ∃ U S,
        ∃ (hU : U.conjTranspose * U = 1) (hS : S.IsUpperTriangular) (hz : Function.Injective fun i => S i i),
          Matrix.of (Function.curry A) = U * S * U.conjTranspose ∧
            Matrix.of (Function.curry A) ∈ (Ginibre.schurChartAt U S hU hS hz).target
