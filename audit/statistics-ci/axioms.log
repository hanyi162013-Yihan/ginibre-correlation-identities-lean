'Ginibre.schurFlatEntryMeasurableEquiv_apply' depends on axioms: [propext, Classical.choice, Quot.sound]
def Ginibre.gaussianEntryLaw : ℝ → MeasureTheory.Measure ℂ :=
fun a => MeasureTheory.volume.withDensity fun z => ENNReal.ofReal (Ginibre.complexGaussianDensity a z)
def Ginibre.gaussianMatrixLaw : (n : ℕ) → ℝ → MeasureTheory.Measure (Fin n × Fin n → ℂ) :=
fun n a => MeasureTheory.Measure.pi fun x => Ginibre.gaussianEntryLaw a
def Ginibre.gaussianCoordinateLaw : (n : ℕ) → ℝ → MeasureTheory.Measure (Ginibre.SchurTangent n) :=
fun n a => MeasureTheory.Measure.map (⇑(Ginibre.schurFlatEntryMeasurableEquiv n)) (Ginibre.gaussianMatrixLaw n a)
def Ginibre.gaussianRetainedSpectralLaw : (k : ℕ) → ℕ → MeasureTheory.Measure (Fin k → ℂ) :=
fun k m =>
  MeasureTheory.Measure.map (Ginibre.retainedSpectrum k m) (Ginibre.gaussianLabelledSpectralLaw (k + m) ↑(k + m))
def Ginibre.retainedSpectrum : (k m : ℕ) → (Fin (k + m) → ℂ) → Fin k → ℂ :=
fun k m A => ((Ginibre.marginalProductEquiv k m) A).2
def Ginibre.schurGlobalAngularCoefficient : ℕ → ℝ → ENNReal :=
fun n a =>
  ∑' (k : ℕ),
    ENNReal.ofReal ((a / Real.pi) ^ (n * n) * (Real.pi / a) ^ Fintype.card (Ginibre.SchurLower n)) *
      Ginibre.schurAngularMass n k
Ginibre.lintegral_schurSpectrum_proportional : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    ∀ (f : (Fin n → ℂ) → ENNReal),
      Measurable f →
        ∫⁻ (A : Ginibre.SchurTangent n), f (Ginibre.schurCoordinateSpectrum A) ∂Ginibre.gaussianCoordinateLaw n a =
          Ginibre.schurGlobalAngularCoefficient n a *
            ∫⁻ (z : Fin n → ℂ) in Ginibre.schurSpectralChamber n,
              ENNReal.ofReal (Ginibre.schurSpectralWeight n a z) * f z
Ginibre.gaussianLabelledSpectralLaw_permute : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    ∀ (σ : Equiv.Perm (Fin n)),
      MeasureTheory.Measure.map (⇑(Ginibre.schurPermute σ)) (Ginibre.gaussianLabelledSpectralLaw n a) =
        Ginibre.gaussianLabelledSpectralLaw n a
