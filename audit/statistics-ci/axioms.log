Ginibre.gaussianLabelledSpectralLaw_eq_withDensity : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    Ginibre.gaussianLabelledSpectralLaw n a =
      MeasureTheory.volume.withDensity fun z => ENNReal.ofReal (Ginibre.determinantDensity n a z)
Ginibre.gaussianOrderedSpectralLaw_eq_candidate_chamber : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    Ginibre.gaussianOrderedSpectralLaw n a =
      (MeasureTheory.volume.restrict (Ginibre.schurSpectralChamber n)).withDensity fun z =>
        ↑n.factorial * ENNReal.ofReal (Ginibre.determinantDensity n a z)
Ginibre.lintegral_gaussianMatrix_labelAverage : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    ∀ (f : (Fin n → ℂ) → ENNReal),
      Measurable f →
        ∫⁻ (A : Fin n × Fin n → ℂ),
            Ginibre.schurLabelAverage n f
              (Ginibre.schurSpectrum (Matrix.of (Function.curry A))) ∂Ginibre.gaussianMatrixLaw n a =
          ∫⁻ (z : Fin n → ℂ), ENNReal.ofReal (Ginibre.determinantDensity n a z) * f z
Ginibre.gaussian_matrix_density_and_correlations : ∀ (k m : ℕ),
  0 < k + m →
    (Ginibre.gaussianLabelledSpectralLaw (k + m) ↑(k + m) =
        MeasureTheory.volume.withDensity fun z => ENNReal.ofReal (Ginibre.determinantDensity (k + m) (↑(k + m)) z)) ∧
      ∀ (z : Fin k → ℂ),
        MeasureTheory.Integrable
            (fun w => Ginibre.determinantDensity (k + m) (↑(k + m)) (Ginibre.prependPoints k m w z))
            MeasureTheory.volume ∧
          Ginibre.ginibreCorrelationDensity k m z = (Ginibre.kernelDet (Ginibre.kernel (k + m)) k z).re
Ginibre.gaussianRetainedSpectralLaw_eq_withDensity : ∀ (k m : ℕ),
  0 < k + m →
    Ginibre.gaussianRetainedSpectralLaw k m =
      MeasureTheory.volume.withDensity fun z => ENNReal.ofReal (Ginibre.ginibreMarginalDensity k m z)
Ginibre.ginibreFactorialCorrelationMeasure_eq_kernelDensity : ∀ (k m : ℕ),
  0 < k + m →
    Ginibre.ginibreFactorialCorrelationMeasure k m =
      MeasureTheory.volume.withDensity fun z => ENNReal.ofReal (Ginibre.kernelDet (Ginibre.kernel (k + m)) k z).re
@Ginibre.charpoly_eq_prod_schurSpectrum : ∀ {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ),
  A.charpoly.Separable → A.charpoly = ∏ i, (Polynomial.X - Polynomial.C (Ginibre.schurSpectrum A i))
def Ginibre.gaussianLabelledSpectralLaw : (n : ℕ) → ℝ → MeasureTheory.Measure (Fin n → ℂ) :=
fun n a =>
  (↑n.factorial)⁻¹ • ∑ σ, MeasureTheory.Measure.map (⇑(Ginibre.schurPermute σ)) (Ginibre.gaussianOrderedSpectralLaw n a)
def Ginibre.gaussianOrderedSpectralLaw : (n : ℕ) → ℝ → MeasureTheory.Measure (Fin n → ℂ) :=
fun n a => MeasureTheory.Measure.map Ginibre.schurCoordinateSpectrum (Ginibre.gaussianCoordinateLaw n a)
def Ginibre.schurCoordinateSpectrum : {n : ℕ} → Ginibre.SchurTangent n → Fin n → ℂ :=
fun {n} x => Ginibre.schurSpectrum ((Ginibre.schurEntrySplit n).symm x)
def Ginibre.schurSpectrum : {n : ℕ} → Matrix (Fin n) (Fin n) ℂ → Fin n → ℂ :=
fun {n} A => if hA : A.charpoly.Separable then fun i => ↑(Classical.choice ⋯).upper i i else 0
def Ginibre.ginibreFactorialCorrelationMeasure : (k : ℕ) → ℕ → MeasureTheory.Measure (Fin k → ℂ) :=
fun k m => ENNReal.ofReal (↑(k + m).factorial / ↑m.factorial) • Ginibre.gaussianRetainedSpectralLaw k m
