Ginibre.weighted_projection : ∀ (n : ℕ) {g : ℂ → ℝ},
  Measurable g →
    (∀ (z : ℂ), 0 ≤ g z) →
      MeasureTheory.Integrable (fun z => g z * Ginibre.onePointDensity n z) MeasureTheory.volume →
        MeasureTheory.Integrable (fun zw => (g zw.1 + g zw.2) * Ginibre.kernelWeight n zw) MeasureTheory.volume ∧
          ∫ (zw : ℂ × ℂ), (g zw.1 + g zw.2) * Ginibre.kernelWeight n zw =
            2 * ↑n * ∫ (z : ℂ), g z * Ginibre.onePointDensity n z
Ginibre.gaussianMatrixLaw_eq_withDensity : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    Ginibre.gaussianMatrixLaw n a =
      MeasureTheory.volume.withDensity fun A => ENNReal.ofReal (Ginibre.gaussianMatrixDensity n a A)
Ginibre.singleton_first_correlation : ∀ (f : ℂ → ℝ),
  Measurable f →
    MeasureTheory.Integrable f (Ginibre.gaussianEntryLaw 1) →
      MeasureTheory.Integrable (fun A => f (A (0, 0))) (Ginibre.gaussianMatrixLaw 1 1) ∧
        ∫ (A : Fin 1 × Fin 1 → ℂ), f (A (0, 0)) ∂Ginibre.gaussianMatrixLaw 1 1 =
          ∫ (z : ℂ), f z * Ginibre.onePointDensity 1 z
Ginibre.integral_determinantDensity : ∀ (n : ℕ) {a : ℝ}, 0 < a → ∫ (z : Fin n → ℂ), Ginibre.determinantDensity n a z = 1
Ginibre.integral_ginibreKernelDet_cons : ∀ (n k : ℕ) (z : Fin k → ℂ),
  ∫ (u : ℂ), Ginibre.kernelDet (Ginibre.kernel n) (k + 1) (Fin.cons u z) =
    (↑n - ↑k) * Ginibre.kernelDet (Ginibre.kernel n) k z
Ginibre.integrable_determinantDensity_prepend : ∀ (k m : ℕ) (z : Fin k → ℂ),
  MeasureTheory.Integrable (fun w => Ginibre.determinantDensity (k + m) (↑(k + m)) (Ginibre.prependPoints k m w z))
    MeasureTheory.volume
Ginibre.integral_determinantDensity_prepend_real : ∀ (k m : ℕ) (z : Fin k → ℂ),
  ∫ (w : Fin m → ℂ), Ginibre.determinantDensity (k + m) (↑(k + m)) (Ginibre.prependPoints k m w z) =
    ↑m.factorial / ↑(k + m).factorial * (Ginibre.kernelDet (Ginibre.kernel (k + m)) k z).re
@Ginibre.det_real_schurLowerMatrix : ∀ {n : ℕ} (S : Matrix (Fin n) (Fin n) ℂ),
  S.IsUpperTriangular →
    (Ginibre.realifyMatrix (Ginibre.schurLowerMatrix S)).det =
      ∏ p, ‖S (Ginibre.schurCol p) (Ginibre.schurCol p) - S (Ginibre.schurRow p) (Ginibre.schurRow p)‖ ^ 2
@Ginibre.hasDerivAt_schur_lower_entry : ∀ {n : ℕ} (U V : ℝ → Matrix (Fin n) (Fin n) ℂ) (D S : Matrix (Fin n) (Fin n) ℂ)
  (ω : Ginibre.SchurLower n → ℂ),
  (∀ (i j : Fin n), HasDerivAt (fun t => U t i j) (Ginibre.schurSkewEmbed ω i j) 0) →
    (∀ (i j : Fin n), HasDerivAt (fun t => V t i j) (D i j) 0) →
      U 0 = 1 →
        V 0 = S →
          S.IsUpperTriangular →
            D.IsUpperTriangular →
              ∀ (p : Ginibre.SchurLower n),
                HasDerivAt (fun t => (U t * V t * (U t).conjTranspose) (Ginibre.schurRow p) (Ginibre.schurCol p))
                  ((Ginibre.schurLowerMatrix S).mulVec ω p) 0
@Ginibre.gaussianMatrixDensity_schur : ∀ {n : ℕ} (a : ℝ) (z : Fin n → ℂ) (U T : Matrix (Fin n) (Fin n) ℂ),
  U.conjTranspose * U = 1 →
    (∀ (i : Fin n), T i i = 0) →
      (Ginibre.gaussianMatrixDensity n a fun ij => (U * (Matrix.diagonal z + T) * U.conjTranspose) ij.1 ij.2) =
        (a / Real.pi) ^ (n * n) * (Real.exp (-a * ∑ i, ‖z i‖ ^ 2) * Real.exp (-a * Ginibre.matrixEnergy T))
Ginibre.gaussianMatrix_charpoly_separable_ae : ∀ (n : ℕ) {a : ℝ},
  0 < a → ∀ᵐ (A : Fin n × Fin n → ℂ) ∂Ginibre.gaussianMatrixLaw n a, (Matrix.of (Function.curry A)).charpoly.Separable
Ginibre.gaussianMatrix_schur_regular_ae : ∀ (n : ℕ) {a : ℝ},
  0 < a →
    ∀ᵐ (A : Fin n × Fin n → ℂ) ∂Ginibre.gaussianMatrixLaw n a,
      ∀ (U S : Matrix (Fin n) (Fin n) ℂ),
        U.conjTranspose * U = 1 →
          S.IsUpperTriangular →
